# Required: host path of the real, verified archive. It is mounted read-only.
ARCHIVE_PATH=/home/hina/Workspace/rosie_rebirth_archive

# Required: keep the local OpenAI-compatible service key out of git.
LOCAL_LLM_API_KEY=replace-with-local-key

# The service uses Linux host networking and listens directly on host port 8765.
# Change the application command in docker-compose.yml to use another port.
ROSIE_CHAT_PORT=8765

# The Compose service uses Linux host networking so these 127.0.0.1 endpoints
# remain external host services reachable inside the container.
ARCHIVE_CHAT_LLM_ENDPOINT=http://127.0.0.1:8000/v1
ARCHIVE_CHAT_LLM_MODEL=Gemma4-26B
ARCHIVE_CHAT_EMBEDDING_ENDPOINT=http://127.0.0.1:8001/v1
ARCHIVE_CHAT_EMBEDDING_MODEL=BAAI/bge-m3
